.venv/
__pycache__/
*.pyc
.DS_Store

# Symlinks into .venv (streamlit's developing-with-streamlit skill,
# dropped at repo root / .claude/skills by the Streamlit package itself)
.agents/
.claude/skills/developing-with-streamlit
data_generator/output/*.csv
data_generator/output/protected_evaluator_only/*.csv
data_generator/output_holdout/*.csv
data_generator/output_holdout/protected_evaluator_only/*.csv
var/
.pytest_cache/
external_events/output/*.csv

# FDM-shaped generated data (regenerate with data_generator/fdm/*)
data_generator/output_fdm/
data_generator/output_fdm_holdout/
data_generator/output_fdm_berka/
external_events/output_fdm/

# Third-party raw data -- never committed. Berka has no stated licence;
# rebuild with `python -m data_generator.external.fetch_berka`.
data_generator/external/berka/

# Real SBA PPP loan data (US government open data) -- large file, never
# committed. Rebuild with `python -m data_generator.external.fetch_sba`.
data_generator/external/sba/
data_generator/output_fdm_sba/

# A1 agent-extracted events + review queue -- generated by
# `python -m external_events.ingest_notices`, not source.
external_events/output_fdm_extracted/
var/agent_traces.db

# Phase 5 onboarding proposals -- generated by
# `python -m onboarding.propose`, per-run output, not source. Accepted
# proposals get COPIED into config/bindings/ and config/entities_*.yaml
# (real, committed files) by `python -m onboarding.accept`; the proposal
# working directory itself never needs to be.
onboarding/proposals/

# secrets: never committed, any environment
.env
.env.*
